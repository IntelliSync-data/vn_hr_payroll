<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Salary Rule Categories -->
        <record id="vnpayroll_category_basic" model="vnpayroll.salary.rule.category">
            <field name="name">Basic</field>
            <field name="code">BASIC</field>
            <!-- <field name="sequence">1</field> -->
        </record>

        <record id="vnpayroll_category_gross" model="vnpayroll.salary.rule.category">
            <field name="name">Gross</field>
            <field name="code">GROSS</field>
            <!-- <field name="sequence">10</field> -->
            <field name="parent_id" ref="vnpayroll_category_basic"/>
        </record>

        <record id="vnpayroll_sarulecat_ded" model="vnpayroll.salary.rule.category">
            <field name="name">Deduction</field>
            <field name="code">DED</field>
            <!-- <field name="sequence">100</field> -->
            <field name="parent_id" ref="vnpayroll_category_gross"/>
        </record>

        <record id="vnpayroll_category_net" model="vnpayroll.salary.rule.category">
            <field name="name">Net</field>
            <field name="code">NET</field>
            <!-- <field name="sequence">200</field> -->
            <field name="parent_id" ref="vnpayroll_sarulecat_ded"/>
        </record>

        <!-- Payroll Structure Type -->
        <record id="vnpayroll_structure_type_freelancer" model="vnpayroll.payroll.structure.type">
            <field name="name">Freelancer/Contractor</field>
            <field name="code">FREELANCER</field>
            <!-- <field name="country_id" ref="base.vn"/> -->
        </record>

        <record id="vnpayroll_structure_type_second_job" model="vnpayroll.payroll.structure.type">
            <field name="name">Second Job</field>
            <field name="code">SECOND_JOB</field>
            <!-- <field name="country_id" ref="base.vn"/> -->
        </record>

        <!-- Basic Salary Rules (placeholders, actual computation might be more complex) -->
        <record id="vnpayroll_rule_basic" model="vnpayroll.salary.rule">
            <field name="name">Basic Salary</field>
            <field name="code">BASIC</field>
            <field name="category_id" ref="vnpayroll_category_basic"/>
            <field name="sequence">1</field>
            <field name="condition_select">none</field>
            <field name="amount_select">python</field>
            <field name="amount_python_compute">result = contract.wage</field> <!-- Assuming contract.wage holds the basic monthly/hourly wage -->
            <field name="appears_on_payslip">True</field>
        </record>

        <record id="vnpayroll_rule_gross" model="vnpayroll.salary.rule">
            <field name="name">Gross Salary</field>
            <field name="code">GROSS</field>
            <field name="category_id" ref="vnpayroll_category_gross"/>
            <field name="sequence">100</field>
            <field name="condition_select">none</field>
            <field name="amount_select">python</field>
            <field name="amount_python_compute">result = categories.BASIC</field>
            <field name="appears_on_payslip">True</field>
        </record>

        <record id="vnpayroll_rule_net" model="vnpayroll.salary.rule">
            <field name="name">Net Salary</field>
            <field name="code">NET</field>
            <field name="category_id" ref="vnpayroll_category_net"/>
            <field name="sequence">200</field>
            <field name="condition_select">none</field>
            <field name="amount_select">python</field>
            <field name="amount_python_compute">result = categories.GROSS + categories.DED</field> <!-- DED is usually negative -->
            <field name="appears_on_payslip">True</field>
        </record>

    </data>
</odoo>
