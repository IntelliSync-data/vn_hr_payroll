<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence for VN Payslip -->
        <record id="seq_vn_payslip" model="ir.sequence">
            <field name="name">Vietnam Payslip</field>
            <field name="code">vn.payslip</field>
            <field name="prefix">PS/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
