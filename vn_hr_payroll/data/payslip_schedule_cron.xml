<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron Job for Auto-Generating Payslips -->
        <record id="ir_cron_payslip_schedule_generate" model="ir.cron">
            <field name="name">Payslip Schedule: Auto-Generate Payslips</field>
            <field name="model_id" ref="model_vn_payslip_schedule"/>
            <field name="state">code</field>
            <field name="code">model.cron_generate_payslips()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
