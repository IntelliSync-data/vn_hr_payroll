<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Salary Rule Category Tree View -->
        <record id="vnpayroll_salary_rule_category_view_list" model="ir.ui.view">
            <field name="name">vnpayroll.salary.rule.category.view.list</field>
            <field name="model">vnpayroll.salary.rule.category</field>
            <field name="arch" type="xml">
                <list string="Salary Rule Categories">
                    <field name="sequence" widget="handle"/>
                    <field name="display_name"/>
                    <field name="parent_id"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </list>
            </field>
        </record>

        <!-- Salary Rule Category Form View -->
        <record id="vnpayroll_salary_rule_category_view_form" model="ir.ui.view">
            <field name="name">vnpayroll.salary.rule.category.view.form</field>
            <field name="model">vnpayroll.salary.rule.category</field>
            <field name="arch" type="xml">
                <form string="Salary Rule Category">
                    <sheet>
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only"/>
                            <h1><field name="name" placeholder="e.g. Basic"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="code"/>
                                <field name="parent_id"/>
                            </group>
                            <group>
                                <field name="sequence"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Child Categories" name="child_categories">
                                <field name="children_ids" nolabel="1">
                                    <list>
                                        <field name="sequence" widget="handle"/>
                                        <field name="display_name"/>
                                        <field name="code"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Notes" name="notes">
                                <field name="note" placeholder="Additional notes about this category..."/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>
