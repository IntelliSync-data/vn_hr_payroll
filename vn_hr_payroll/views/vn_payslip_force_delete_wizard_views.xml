<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vn_payslip_force_delete_wizard_form" model="ir.ui.view">
        <field name="name">vn.payslip.force.delete.wizard.form</field>
        <field name="model">vn.payslip.force.delete.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirm Force Delete">
                <div class="alert alert-warning" role="alert">
                    <h4>Warning!</h4>
                    <p><field name="confirmation_message" readonly="1" nolabel="1" options="{'safe': True}"/></p>
                    <p>This action cannot be undone.</p>
                    <field name="payslip_id" invisible="1"/>
                    <field name="payslip_ids" invisible="1"/>
                </div>
                <footer>
                    <button string="Yes, Delete" name="action_confirm" type="object" class="btn-primary"/>
                    <button string="Cancel" name="action_cancel" type="object" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
