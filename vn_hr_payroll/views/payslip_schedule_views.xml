<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Payslip Schedule Form View -->
        <record id="vn_payslip_schedule_view_form" model="ir.ui.view">
            <field name="name">vn.payslip.schedule.view.form</field>
            <field name="model">vn.payslip.schedule</field>
            <field name="arch" type="xml">
                <form string="Payslip Schedule">
                    <header>
                        <button name="action_generate_payslips" type="object" string="Generate Now" class="oe_highlight" confirm="Generate payslips for all employees now?"/>
                        <field name="active" widget="boolean_toggle"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_payslips" type="object" class="oe_stat_button" icon="fa-file-text">
                                <field name="payslip_count" widget="statinfo" string="Payslips"/>
                            </button>
                        </div>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="e.g. Monthly Payroll"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="day_of_month"/>
                                <field name="payslip_period_type"/>
                                <field name="last_generated_date" readonly="1"/>
                            </group>
                            <group>
                                <field name="next_generation_date" readonly="1"/>
                                <field name="employee_count" readonly="1"/>
                            </group>
                        </group>
                        <group string="Description">
                            <field name="description" nolabel="1" placeholder="Enter schedule description..."/>
                        </group>
                        <group string="Employees">
                            <field name="employee_ids" nolabel="1" widget="many2many_tags" options="{'color_field': 'color'}"/>
                        </group>
                        <div class="alert alert-info" role="alert">
                            <strong>ℹ️ How it works:</strong>
                            <ul>
                                <li><strong>Auto Schedule:</strong> Payslips will be generated on day <strong><field name="day_of_month" readonly="1" nolabel="1"/></strong> of each month</li>
                                <li><strong>Payslip Period:</strong>
                                    <ul>
                                        <li><strong>Previous Month:</strong> On 25th, generate payslip for previous month</li>
                                        <li><strong>Current Month:</strong> On 25th, generate payslip for current month</li>
                                    </ul>
                                </li>
                                <li><strong>Generate Now:</strong> Always creates payslip for <strong>current month</strong> regardless of period setting</li>
                                <li>All generated payslips will be in <strong>Draft</strong> state for review</li>
                            </ul>
                        </div>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Payslip Schedule List View -->
        <record id="vn_payslip_schedule_view_tree" model="ir.ui.view">
            <field name="name">vn.payslip.schedule.view.list</field>
            <field name="model">vn.payslip.schedule</field>
            <field name="arch" type="xml">
                <list string="Payslip Schedules">
                    <field name="name"/>
                    <field name="day_of_month"/>
                    <field name="payslip_period_type"/>
                    <field name="employee_count"/>
                    <field name="last_generated_date"/>
                    <field name="next_generation_date"/>
                    <field name="payslip_count"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <!-- Payslip Schedule Search View -->
        <record id="vn_payslip_schedule_view_search" model="ir.ui.view">
            <field name="name">vn.payslip.schedule.view.search</field>
            <field name="model">vn.payslip.schedule</field>
            <field name="arch" type="xml">
                <search string="Search Payslip Schedules">
                    <field name="name"/>
                    <field name="employee_ids"/>
                    <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                    <filter string="Inactive" name="inactive" domain="[('active', '=', False)]"/>
                    <group expand="0" string="Group By">
                        <filter string="Day of Month" name="group_day" context="{'group_by': 'day_of_month'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Payslip Schedule Action -->
        <record id="action_vn_payslip_schedule" model="ir.actions.act_window">
            <field name="name">Payslip Schedules</field>
            <field name="res_model">vn.payslip.schedule</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'search_default_active': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new payslip schedule
                </p>
                <p>
                    Automate your payroll process by creating schedules that automatically generate payslips on a specific day each month.
                </p>
            </field>
        </record>

    </data>
</odoo>
