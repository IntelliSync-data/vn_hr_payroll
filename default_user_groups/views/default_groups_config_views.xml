<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Default Groups Configuration Form -->
        <record id="view_default_groups_config_form" model="ir.ui.view">
            <field name="name">Default Groups Configuration</field>
            <field name="model">default.groups.config</field>
            <field name="arch" type="xml">
                <form string="Default Groups Configuration">
                    <sheet>
                        <div class="oe_title">
                            <h1>Default User Groups</h1>
                        </div>
                        <group>
                            <group>
                                <field name="default_user_group_ids" widget="many2many_tags" 
                                       options="{'no_create': True}"/>
                            </group>
                        </group>
                        <div class="alert alert-info" role="alert">
                            <strong>Information:</strong>
                            <ul>
                                <li>Groups selected here will be automatically assigned to new users when they are created or invited.</li>
                                <li>This will not affect existing users or admin users.</li>
                                <li>Changes take effect immediately for new user registrations.</li>
                            </ul>
                        </div>
                    </sheet>
                    <footer>
                        <button name="action_save" type="object" string="Save" class="btn-primary"/>
                        <button name="action_reset" type="object" string="Reset" class="btn-secondary" 
                                confirm="Are you sure you want to reset the default groups configuration?"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Action -->
        <record id="action_default_groups_config" model="ir.actions.act_window">
            <field name="name">Default User Groups</field>
            <field name="res_model">default.groups.config</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <!-- Menu -->
        <menuitem id="menu_default_groups_config"
                  name="Default User Groups"
                  parent="base.menu_users"
                  action="action_default_groups_config"
                  sequence="99"
                  groups="base.group_system"/>

    </data>
</odoo>